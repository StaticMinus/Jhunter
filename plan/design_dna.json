{
  "design_system": {
    "color": {
      "mode": "dark",
      "primary": {
        "hex": "#06B6D4",
        "name": "Electric Cyan",
        "role": "Primary brand accent, interactive elements, high-signal highlights"
      },
      "secondary": {
        "hex": "#3B82F6",
        "name": "Cobalt Blue",
        "role": "Secondary action items, info indicators, system links"
      },
      "accent": {
        "hex": "#10B981",
        "name": "Emerald Signal",
        "role": "Match score >= 85%, verified facts, success states"
      },
      "opportunity": {
        "hex": "#F59E0B",
        "name": "Amber Gold",
        "role": "High opportunity score, visa sponsorship indicated, premium leads"
      },
      "surface": {
        "background": "#080B11",
        "card": "rgba(17, 24, 39, 0.70)",
        "card_hover": "rgba(30, 41, 59, 0.85)",
        "border": "rgba(255, 255, 255, 0.08)",
        "border_glow": "rgba(6, 182, 212, 0.35)"
      },
      "text": {
        "primary": "#F9FAFB",
        "secondary": "#9CA3AF",
        "muted": "#6B7280"
      }
    },
    "typography": {
      "font_families": {
        "heading": "Outfit, system-ui, -apple-system, sans-serif",
        "body": "Inter, system-ui, -apple-system, sans-serif",
        "mono": "JetBrains Mono, monospace"
      },
      "scale": {
        "xs": "0.75rem",
        "sm": "0.875rem",
        "base": "1rem",
        "lg": "1.125rem",
        "xl": "1.25rem",
        "2xl": "1.5rem",
        "3xl": "1.875rem",
        "4xl": "2.25rem"
      }
