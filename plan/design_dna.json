    "shape": {
      "border_radius": {
        "small": "6px",
        "medium": "12px",
        "large": "16px",
        "pill": "9999px"
      }
    },
    "elevation": {
      "glass": "0 8px 32px 0 rgba(0, 0, 0, 0.37)",
      "glow_cyan": "0 0 20px rgba(6, 182, 212, 0.25)",
      "glow_emerald": "0 0 20px rgba(16, 185, 129, 0.25)",
      "glow_amber": "0 0 20px rgba(245, 158, 11, 0.25)"
    },
    "motion": {
      "easing": "cubic-bezier(0.16, 1, 0.3, 1)",
      "duration_scale": {
        "micro": "150ms",
        "normal": "300ms",
        "macro": "500ms"
      }
    }
  },
  "design_style": {
    "aesthetic": {
      "mood": "Sovereign Executive Intelligence, Precision Tech, Ultra-Luxury Dark Elegance",
      "contrast_level": "High-fidelity micro-contrast with glowing accents"
    },
    "visual_language": {
      "surface_treatment": "Frosted Liquid Glass with dynamic refraction borders",
      "whitespace_usage": "Generous executive spacing, breathing room for dense telemetry"
    }
  },
  "visual_effects": {
    "overview": {
      "effect_intensity": "medium",
      "performance_tier": "medium",
      "fallback_strategy": "Static CSS blur and gradients on reduced motion"
    },
    "background_effects": {
      "type": "mesh-gradient-ambient",
      "enabled": true,
      "parameters": {
        "color1": "#0B1528",
        "color2": "#051B1E",
        "color3": "#080B11",
        "animation_duration": "18s"
      }
    },
    "glassmorphism": {
      "type": "liquid-glass",
      "blur_radius": "20px",
      "transparency": 0.75,
      "border_glow": true
    }
  }
