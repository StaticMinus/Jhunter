# ─── Application & Database ───
DATABASE_URL=postgresql+asyncpg://jhunter:jhunter_secret@localhost:5432/jhunter
SECRET_KEY=generate_with_openssl_rand_hex_32
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Google OAuth & Gmail API ───
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ─── Telegram Bot Alerts ───
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_telegram_chat_or_channel_id

# ─── AI Engine (Google Gemini) ───
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=your_google_gemini_api_key

# ─── Security & Encryption ───
ENCRYPTION_KEY=your_fernet_or_aes_key
CRON_SECRET=your_cron_invocation_secret
